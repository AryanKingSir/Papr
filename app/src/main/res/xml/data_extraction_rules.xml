<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The cloud backup keeps only the settings (DataStore): scans stay on the phone,
     and a backup over Android's 25 MB cap would otherwise silently stop backing the app up at all.
     A direct phone-to-phone transfer has no such cap, so it moves everything, scans included. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
